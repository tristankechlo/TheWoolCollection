{
    "schemaVersion": 1,
    "id": "wool_collection",
    "version": "${version}",
    "name": "The Wool Collection",
    "description": "Adds wool variants for various blocks, like fences, stairs, gates, buttons and more!",
    "authors": [
        "Buecher_wurm"
    ],
    "contact": {
        "sources": "https://github.com/tristankechlo/TheWoolCollection",
        "issues": "https://github.com/tristankechlo/TheWoolCollection/issues",
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/wool-collection"
    },
    "license": "CC BY-NC-ND 4.0",
    "icon": "pack.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.tristankechlo.wool_collection.TheWoolCollectionFabric"
        ],
        "client": [
            "com.tristankechlo.wool_collection.TheWoolCollectionFabricClient"
        ],
        "jei_mod_plugin": [
            "com.tristankechlo.wool_collection.jei.JustEnoughItemsPlugin"
        ]
    },
    "mixins": [
    ],
    "accessWidener" : "wool_collection.accesswidener",
    "depends": {
        "fabricloader": ">=${fabric_loader_min}",
        "fabric-api": "*",
        "minecraft": ">=${fabric_range_min_inclusive} <${fabric_range_max_exclusive}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/bhUaWhq",
                "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/wool-collection",
                "modmenu.modrinth": "https://modrinth.com/mod/wool-collection"
            }
        }
    }
}
  